{
  "name": "daily-private-journal",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "node tools/serve.mjs",
    "review": "node tools/serve.mjs --review",
    "test:browser": "node tools/browser-check.mjs",
    "verify:local": "node tools/verify-local.mjs",
    "check:release": "node tools/release-check.mjs",
    "prepare-import": "node tools/import.mjs prepare",
    "verify-import": "node tools/import.mjs verify",
    "import": "node tools/import.mjs upload",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.111.0",
    "dompurify": "3.4.15",
    "fflate": "0.8.3",
    "lucide": "0.468.0",
    "marked": "15.0.12"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@electric-sql/pglite": "0.3.14",
    "esbuild": "0.25.10",
    "jsdom": "26.1.0"
  }
}
